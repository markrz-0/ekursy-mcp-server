MOODLE_USERNAME="your.email@student.put.poznan.pl"
MOODLE_PASSWORD="your-university-password"

MCP_TRANSPORT="streamable-http"
MCP_AUTH_PROVIDER="github"
MCP_PUBLIC_URL="https://mk.uni.markrz0.dev"

# Create a GitHub OAuth app with callback:
# https://mk.uni.markrz0.dev/auth/callback
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""

# Generate both independently with: openssl rand -hex 32
OAUTH_JWT_SIGNING_KEY=""
# Never rotate this key while the database contains stored credentials.
CREDENTIAL_ENCRYPTION_KEY=""

DATABASE_PATH="/app/data/ekursy.db"
ACCOUNT_SETUP_TOKEN_TTL="600"

# Bootstrap only: this login is inserted on its next successful OAuth request.
# Add friends with the admin invite command instead of editing this list.
OAUTH_ALLOWED_GITHUB_USERS="markrz-0"

# ChatGPT's stable and callback-specific redirects plus local MCP Inspector.
OAUTH_ALLOWED_REDIRECT_URIS="https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,http://127.0.0.1:*/callback"
